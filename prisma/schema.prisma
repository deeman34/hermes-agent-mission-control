generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Draft {
  id              String    @id @default(uuid())
  text            String
  title           String?
  model           String?
  status          String    @default("pending")
  type            String?
  category        String?
  hookType        String?
  feedbackRating  String?
  feedbackReason  String?
  viralScore      Json?
  impressionScore Json?
  scheduledDate   String?
  scheduledTime   String?
  visualUrl       String?
  variantGroup    String?
  postedAt        DateTime?
  postedUrl       String?
  tweetUrl        String?
  tweetId         String?
  metrics         Json?
  editHistory     Json?     @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quoteUrl        String?
  quoteText       String?
  source          String?
  engagementScore Float?
  engagementTier  String?

  @@index([status])
  @@index([createdAt])
  @@index([tweetId])
  @@index([source])
  @@index([engagementTier])
}

model TweetMetric {
  id          String    @id @default(cuid())
  draftId     String
  tweetId     String?
  url         String?
  postedAt    DateTime?
  checkpoints Json?
  createdAt   DateTime  @default(now())

  @@index([draftId])
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])
}

model ContentCalendar {
  id   String @id @default(cuid())
  week String @unique
  data Json
}

model YoutubeIdea {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  angle            String?
  hookType         String?
  funnelStage      String?
  status           String   @default("pending")
  rejectedReason   String?
  sourceUrl        String?
  sourceSummary    String?
  competitionScore String?
  competitionData  Json?
  createdAt        DateTime @default(now())

  @@index([status])
}

model YoutubeScript {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  storySetup       String?
  conflict         String?
  insight          String?
  cta              String?
  caption          String?
  onScreenText     String?
  hookType         String?
  funnelStage      String?
  factCheck        Json?
  fullScript       String?
  status           String   @default("draft")
  rejectedReason   String?
  seoTitle         String?
  seoDescription   String?
  seoTags          Json?
  seoChapters      Json?
  titleVariants    Json?
  thumbnailConcept String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model YoutubeFeedback {
  id     String   @id @default(cuid())
  title  String
  reason String?
  type   String?
  date   DateTime @default(now())
}

model LongformScript {
  id               String    @id @default(cuid())
  title            String
  type             String?
  status           String    @default("draft")
  platform         String?
  platforms        Json?
  description      String?
  hook             String?
  outline          String?
  fullScript       String?
  targetLength     String?
  factCheck        Json?
  notes            String?
  rejectedReason   String?
  youtubeUrl       String?
  thumbnailUrl     String?
  tweetUrl         String?
  youtubeViews     Int?
  youtubeLikes     Int?
  youtubeComments  Int?
  tweetViews       Int?
  tweetLikes       Int?
  tweetBookmarks   Int?
  tweetRetweets    Int?
  tweetReplies     Int?
  postedAt         DateTime?
  competitionScore String?
  competitionData  Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model BattleRoyaleBot {
  id        String   @id
  state     Json
  updatedAt DateTime @updatedAt
}

model ContentRequest {
  id             String    @id @default(uuid())
  prompt         String
  status         String    @default("pending")
  resultDraftIds Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Brief {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String
  source    String   @default("brief")
  createdAt DateTime @default(now())
}

model Mission {
  id          String    @id @default(uuid())
  agentId     String
  title       String
  description String
  status      String    @default("pending")
  priority    String    @default("medium")
  result      String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

model Article {
  id              String    @id @default(uuid())
  title           String
  body            String
  track           String
  status          String    @default("idea")
  qtTweet         String?
  qtUrl           String?
  heroImageUrl    String?
  heroImageHtml   String?
  inspirationUrls String?
  themes          String?
  scheduledDate   String?
  postedAt        DateTime?
  postedUrl       String?
  impressions     Int?
  likes           Int?
  bookmarks       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([track])
  @@index([scheduledDate])
}

model SavedTitle {
  id        String   @id @default(cuid())
  title     String
  track     String
  themes    String?
  createdAt DateTime @default(now())

  @@index([track])
}

model ClientPulseClient {
  id                   String                @id @default(cuid())
  notionPageId         String?               @unique
  clientName           String
  status               String?
  services             Json                  @default("[]")
  productManagerName   String?
  renewalDate          DateTime?
  endDate              DateTime?
  expectedCheckinHours Int                   @default(72)
  sourceUpdatedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  alerts               ClientPulseAlert[]
  analyses             ClientPulseAnalysis[]
  chats                ClientPulseChat[]

  @@index([status])
  @@index([clientName])
  @@index([productManagerName])
}

model ClientPulseChat {
  id              String               @id @default(cuid())
  telegramChatId  String               @unique
  title           String
  linkedClientId  String?
  status          String               @default("active")
  internalUserIds Json                 @default("[]")
  lastSeenAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  alerts          ClientPulseAlert[]
  linkedClient    ClientPulseClient?   @relation(fields: [linkedClientId], references: [id])
  messages        ClientPulseMessage[]

  @@index([linkedClientId])
  @@index([status])
}

model ClientPulseMessage {
  id                String           @id @default(cuid())
  telegramMessageId String
  telegramChatId    String
  chatId            String?
  senderTelegramId  String
  senderName        String
  isInternal        Boolean          @default(false)
  isBot             Boolean          @default(false)
  text              String
  sentAt            DateTime
  intent            String           @default("other")
  sentiment         String           @default("neutral")
  needsReply        Boolean          @default(false)
  rawJson           Json?
  createdAt         DateTime         @default(now())
  chat              ClientPulseChat? @relation(fields: [chatId], references: [id])

  @@unique([telegramChatId, telegramMessageId])
  @@index([telegramChatId, sentAt])
  @@index([chatId, sentAt])
  @@index([needsReply])
}

model ClientPulseAnalysis {
  id                  String            @id @default(cuid())
  clientId            String
  windowStart         DateTime
  windowEnd           DateTime
  sentimentScore      Int
  responseScore       Int
  cadenceScore        Int
  renewalRiskScore    Int
  positiveSignalScore Int               @default(70)
  overallScore        Int
  category            String
  reasons             Json              @default("[]")
  evidence            Json              @default("[]")
  recommendedAction   String?
  llmSummary          String?
  analysisSource      String            @default("fallback")
  analyzedAt          DateTime          @default(now())
  client              ClientPulseClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, analyzedAt])
  @@index([category])
  @@index([overallScore])
}

model ClientPulseAlert {
  id                String             @id @default(cuid())
  clientId          String?
  chatId            String?
  type              String
  severity          String
  evidence          Json               @default("[]")
  reason            String
  recommendedAction String?
  sentTo            String?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime           @default(now())
  chat              ClientPulseChat?   @relation(fields: [chatId], references: [id])
  client            ClientPulseClient? @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
  @@index([severity])
  @@index([sentAt])
  @@index([acknowledgedAt])
}

model AgentRequest {
  id            String    @id @default(cuid())
  origin        String    @default("web")
  kind          String    @default("oneshot")
  title         String
  prompt        String?
  sideEffecting Boolean   @default(false)
  status        String    @default("queued")
  result        String?
  error         String?
  hermesTaskId  String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  kind      String   @default("activity")
  title     String
  detail    String?
  agent     String?
  level     String   @default("info")
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HermesTask {
  id        String   @id
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt

  @@index([board])
  @@index([status])
}

model HermesMemory {
  id         String    @id
  path       String
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
}

model Business {
  id            String             @id @default(cuid())
  name          String
  domain        String?            @unique
  website       String?
  email         String?
  industry      String?
  size          String?
  status        String             @default("prospect")
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  activities    BusinessActivity[]
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  revenues      Revenue[]

  @@index([status])
  @@index([industry])
}

model Contact {
  id            String        @id @default(cuid())
  businessId    String?
  name          String
  email         String?
  phone         String?
  role          String?
  source        String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business?     @relation(fields: [businessId], references: [id])
  leads         Lead[]
  opportunities Opportunity[]

  @@index([businessId])
  @@index([email])
}

model Lead {
  id              String    @id @default(cuid())
  businessId      String?
  contactId       String?
  source          String
  status          String    @default("new")
  score           Int?
  scoreFactors    Json?
  estimatedValue  Decimal?  @db.Decimal(12, 2)
  ownerId         String?
  notes           String?
  draftBody       String?
  outreachChannel String?
  qualifiedAt     DateTime?
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business? @relation(fields: [businessId], references: [id])
  contact         Contact?  @relation(fields: [contactId], references: [id])

  @@index([status])
  @@index([source])
  @@index([score])
  @@index([ownerId])
  @@index([businessId])
}

model Opportunity {
  id             String    @id @default(cuid())
  businessId     String
  contactId      String?
  leadId         String?
  status         String    @default("open")
  stage          String    @default("outreach")
  estimatedValue Decimal?  @db.Decimal(12, 2)
  currency       String    @default("USD")
  expectedClose  DateTime?
  ownerId        String?
  notes          String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact        Contact?  @relation(fields: [contactId], references: [id])
  revenues       Revenue[]

  @@index([status])
  @@index([stage])
  @@index([expectedClose])
  @@index([ownerId])
  @@index([businessId])
}

model Revenue {
  id            String       @id @default(cuid())
  businessId    String
  opportunityId String?
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("USD")
  type          String       @default("new")
  recognizedAt  DateTime     @default(now())
  notes         String?
  createdAt     DateTime     @default(now())
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([recognizedAt])
  @@index([businessId])
  @@index([opportunityId])
}

model BusinessActivity {
  id               String    @id @default(cuid())
  businessId       String?
  entityType       String
  entityId         String
  type             String
  title            String
  detail           String?
  actor            String?
  linkHermesTaskId String?
  at               DateTime  @default(now())
  business         Business? @relation(fields: [businessId], references: [id])

  @@index([entityType, entityId, at])
  @@index([businessId, at])
}
